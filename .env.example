# Backend
APP_NAME=AI Resume Screening System
DATASET_SLUG=rhythmghai/resume-screening-dataset-200k-candidates
LOCAL_DATASET_PATH=
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|(\\d{1,3}\\.){3}\\d{1,3})(:\\d+)?$
RANDOM_SEED=42
DEFAULT_TRAINING_PROFILE=server_max
MAX_CPU_WORKERS=38
TORCH_DATA_LOADER_WORKERS=16
TORCH_PREFETCH_FACTOR=4
TORCH_PIN_MEMORY=true
TORCH_PERSISTENT_WORKERS=true
TORCH_COMPILE_ENABLED=true
TORCH_AMP_ENABLED=true
TORCH_ALLOW_TF32=true
TORCH_USE_DATA_PARALLEL=true
TORCH_EVAL_BATCH_SIZE=131072
SERVER_MAX_CLASSIFICATION_MODELS=["catboost","xgboost","hist_gradient_boosting","extra_trees","random_forest","torch_mlp"]
SERVER_MAX_REGRESSION_MODELS=["catboost","xgboost","hist_gradient_boosting","extra_trees","random_forest","torch_mlp"]
OMP_NUM_THREADS=38
MKL_NUM_THREADS=38
NUMEXPR_MAX_THREADS=38
NVIDIA_VISIBLE_DEVICES=all

# Frontend
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
